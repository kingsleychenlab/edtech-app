# Copy this file to .env for local development:
#   cp .env.example .env
#
# On Vercel, set these same keys as Environment Variables in the project
# settings instead — .env is never deployed.

# --- Server ---------------------------------------------------------------
# Port for the local server. Ignored on Vercel. Defaults to 4173.
PORT=4173

# --- AI tools (optional) --------------------------------------------------
# Get a free key at https://console.groq.com/keys
# Without this key the AI features return HTTP 503; everything else still works.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Payments (optional) --------------------------------------------------
# Stripe Payment Link URLs created in the Stripe dashboard.
# Without these the pricing buttons return HTTP 503.
STRIPE_CHECKOUT_WEEKLY_URL=
STRIPE_CHECKOUT_MONTHLY_URL=
STRIPE_CHECKOUT_YEARLY_URL=
